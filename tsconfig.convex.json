{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDirs": ["./convex", "./types/convex-shim"],
    "types": []
  },
  "include": ["convex/**/*.ts", "types/convex-shim/**/*.ts"]
}
