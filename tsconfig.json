{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDirs": ["./convex", "./types/convex-shim"],
    "types": []
  },
  "include": ["src-react/**/*", "types/**/*.d.ts"]
}
